# Copy to .env.local for local dev, and set the SAME values in Vercel -> Project -> Settings ->
# Environment Variables. None of these are exposed to the browser.

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://bpcgatpyzzhojgfstcgw.supabase.co
# The "service_role" secret key. It bypasses RLS so the map can read every account's presence.
# Keep it secret: server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The code you type to open the admin map. Choose anything strong.
ADMIN_CODE=change-me
